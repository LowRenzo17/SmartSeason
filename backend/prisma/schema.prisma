generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int         @id @default(autoincrement())
  username          String      @unique
  passwordHash      String
  role              Role        @default(AGENT)
  createdAt         DateTime    @default(now())
  createdByAdminId  Int?
  createdByAdmin    User?       @relation("AdminAgents", fields: [createdByAdminId], references: [id])
  agents            User[]      @relation("AdminAgents")
  fields            Field[]     @relation("AgentFields")
  notes             FieldNote[]
  diagnoses         CropDiagnosis[]
}

model Field {
  id           Int         @id @default(autoincrement())
  name         String
  cropType     String
  plantingDate DateTime
  currentStage Stage       @default(PLANTED)
  
  agentId      Int?
  agent        User?       @relation("AgentFields", fields: [agentId], references: [id])
  
  notes        FieldNote[]
  diagnoses    CropDiagnosis[]
}

model FieldNote {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  
  fieldId   Int
  field     Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
}

model CropDiagnosis {
  id              Int      @id @default(autoincrement())
  cropType        String?
  symptoms        String?
  imageDataUrl    String
  suspectedIssue  String
  severity        String
  confidence      Int
  summary         String
  remedies        String[]
  prevention      String[]
  escalation      String
  source          String   @default("fallback")
  createdAt       DateTime @default(now())

  fieldId         Int
  field           Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  authorId        Int
  author          User     @relation(fields: [authorId], references: [id])
}

enum Role {
  ADMIN
  AGENT
}

enum Stage {
  PLANTED
  GROWING
  READY
  HARVESTED
}
